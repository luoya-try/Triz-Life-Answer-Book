}

.dopamine-theme .chip-remove {
  background: linear-gradient(135deg, #FFB5C5 0%, #FF9AA2 100%) !important;
  color: white !important;
}

.dopamine-theme .status-icon {
  animation: twinkle 1s ease-in-out infinite !important;
}

/* 动画 */
@keyframes gradientShift {
  0%, 100% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8rpx); }
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

@keyframes twinkle {
  0%, 100% { opacity: 1; transform: scale(1.1); }
  50% { opacity: 0.5; transform: scale(1); }
}

.dopamine-theme .tooltip-content {
  background: linear-gradient(135deg, #FF6B9D 0%, #FFD93D 100%) !important;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 157, 0.3) !important;
}

.dopamine-theme .expand-toggle {
  background: linear-gradient(135deg, #FFF9E6 0%, #FFEFF5 100%) !important;
  border: 3rpx dashed #FFD93D !important;
  border-radius: 40rpx !important;
}

.dopamine-theme .expand-text {
  color: #FF6B9D !important;
  font-weight: 700 !important;
}

.dopamine-theme .expand-icon {
  color: #FFD93D !important;
}

.tooltip-wrapper {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 9999;
  pointer-events: none;
}

.tooltip-content {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  padding: 30rpx 40rpx;
  border-radius: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.4);
  max-width: 500rpx;
  text-align: center;
  animation: tooltipPop 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55);
}

.tooltip-content::before {
  content: '';
  position: absolute;
  bottom: -20rpx;
  left: 50%;
  transform: translateX(-50%);
  border: 20rpx solid transparent;
  border-top-color: #667eea;
}

.tooltip-text {
  font-size: 24rpx;
  line-height: 1.6;
  color: white;
}

.tooltip-wrapper.fade-out {
  animation: tooltipFadeOut 0.3s ease-out forwards;
}

@keyframes tooltipPop {
  0% {
    opacity: 0;
    transform: scale(0.5);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes tooltipFadeOut {
  0% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
  100% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.8);
  }
}

.dopamine-theme .tooltip-content {
  background: linear-gradient(135deg, #FF6B9D 0%, #FFD93D 100%) !important;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 157, 0.3) !important;
}

.dopamine-theme .tooltip-content::before {
  border-top-color: #FF6B9D !important;
}

/* 空状态样式 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 15rpx;
  display: block;
}

.empty-desc {
  font-size: 24rpx;
  color: #6c757d;
  line-height: 1.6;
  margin-bottom: 40rpx;
  display: block;
}

.goto-questionnaire-btn {
  width: 80%;
  height: 80rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  font-size: 26rpx;
  font-weight: bold;
  border-radius: 40rpx;
  box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.4);
  
}

.goto-questionnaire-btn::after {
  
}

.goto-questionnaire-btn:active {
  transform: scale(0.98);
  opacity: 0.8;
}

.dopamine-theme .empty-state {
  background: rgba(255, 255, 255, 0.8) !important;
  border: 3rpx dashed #FF6B9D !important;
  border-radius: 30rpx !important;
}

.dopamine-theme .empty-title {
  color: #2D1B4E !important;
  font-weight: 700 !important;
}

.dopamine-theme .empty-desc {
  color: #666 !important;
  font-weight: 500 !important;
}

.dopamine-theme .goto-questionnaire-btn {
  background: linear-gradient(135deg, #FF6B9D 0%, #FFD93D 100%) !important;
  border: 3rpx solid #FFF !important;
  box-shadow: 0 8rpx 25rpx rgba(255, 107, 157, 0.4) !important;
}
