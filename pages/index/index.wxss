.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: linear-gradient(180deg, #f8f9fa 0%, #e9ecef 100%);
}

.header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  padding: 60rpx 0 40rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(102, 126, 234, 0.3);
  position: relative;
  overflow: hidden;
}

.header::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 300rpx;
  height: 300rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.logo {
  font-size: 100rpx;
  margin-bottom: 20rpx;
  display: block;
}

.title {
  font-size: 42rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
  display: block;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.2);
}

.subtitle {
  font-size: 24rpx;
  opacity: 0.9;
  display: block;
  letter-spacing: 2rpx;
}

.content {
  flex: 1;
  padding: 30rpx;
}

.feature-section {
  background-color: white;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  font-size: 24rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 15rpx;
  display: block;
  position: relative;
  padding-left: 15rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 5rpx;
  height: 18rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 2.5rpx;
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.feature-item {
  display: flex;
  align-items: flex-start;
  gap: 15rpx;
  padding: 12rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
  border-radius: 12rpx;
  border: 1rpx solid #e9ecef;
  transition: all 0.3s ease;
}

.feature-icon {
  width: 36rpx;
  height: 36rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: bold;
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.3);
}

.feature-text {
  flex: 1;
}

.feature-title {
  font-size: 22rpx;
  font-weight: bold;
  color: #2c3e50;
  display: block;
  margin-bottom: 6rpx;
}

.feature-desc {
  font-size: 18rpx;
  color: #6c757d;
  line-height: 1.5;
  display: block;
}

.btn-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  justify-content: center;
  margin-top: 20rpx;
}

.start-btn {
  width: 80%;
  height: 90rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 45rpx;
  box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.4);
  border: none;
  letter-spacing: 2rpx;
  transition: all 0.3s ease;
}

.start-btn::after {
  border: none;
}

.start-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
}

.test-btn {
  width: 80%;
  height: 70rpx;
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  color: white;
  font-size: 24rpx;
  font-weight: bold;
  border-radius: 35rpx;
  box-shadow: 0 4rpx 16rpx rgba(245, 87, 108, 0.3);
  border: none;
  transition: all 0.3s ease;
}

.test-btn::after {
  border: none;
}

.test-btn:active {
  transform: scale(0.98);
}

.footer {
  background-color: white;
  padding: 25rpx;
  text-align: center;
  border-top: 1rpx solid #e9ecef;
}

.footer-links {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 15rpx;
}

.footer-text {
  font-size: 20rpx;
  color: #adb5bd;
}

.footer-divider {
  color: #e9ecef;
  font-size: 18rpx;
}

.footer-link {
  font-size: 20rpx;
  color: #667eea;
  text-decoration: none;
}

.footer-link:active {
  opacity: 0.7;
}

/* ==================== 多巴胺风样式 ==================== */

.dopamine-theme {
  background: #FFF9E6 !important;
}

.dopamine-theme .header {
  background: linear-gradient(135deg, #FF6B9D 0%, #FFD93D 50%, #FF9AA2 100%) !important;
  animation: gradientShift 8s ease infinite !important;
  background-size: 200% 200% !important;
  position: relative;
}

.dopamine-theme .header::before {
  background: rgba(255, 255, 255, 0.2) !important;
  animation: float 4s ease-in-out infinite !important;
}

.dopamine-theme .logo {
  font-size: 120rpx !important;
  animation: logoFloat 3s ease-in-out infinite !important;
}

.dopamine-theme .title {
  font-size: 52rpx !important;
  font-weight: 900 !important;
  color: #2D1B4E !important;
  text-shadow: 3rpx 3rpx 0px #FFD93D, 6rpx 6rpx 0px rgba(255, 215, 61, 0.3) !important;
}

.dopamine-theme .subtitle {
  font-size: 26rpx !important;
  color: #FF9AA2 !important;
  font-weight: 600 !important;
  animation: textPulse 2s ease-in-out infinite !important;
}

.dopamine-theme .feature-section {
  background: rgba(255, 255, 255, 0.8) !important;
  border: 3rpx dashed #FF6B9D !important;
  border-radius: 25rpx !important;
}

.dopamine-theme .section-title {
  background: linear-gradient(135deg, #FF6B9D 0%, #FFD93D 100%) !important;
  -webkit-background-clip: text !important;
  -webkit-text-fill-color: transparent !important;
  font-weight: 900 !important;
  font-size: 28rpx !important;
  text-shadow: none !important;
}

.dopamine-theme .section-title::before {
  display: none !important;
}

.dopamine-theme .feature-item {
  background: #FFF !important;
  border: 2rpx solid transparent !important;
  border-radius: 25rpx !important;
  box-shadow: 6rpx 6rpx 0px rgba(102, 126, 234, 0.15) !important;
  transition: all 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55) !important;
}

.dopamine-theme .feature-item:active {
  transform: scale(0.95) rotate(-2deg) !important;
}

.dopamine-theme .feature-icon {
  background: linear-gradient(135deg, #FF6B9D 0%, #FFD93D 100%) !important;
  width: 50rpx !important;
  height: 50rpx !important;
  font-size: 24rpx !important;
  box-shadow: 0 4rpx 15rpx rgba(255, 107, 157, 0.4) !important;
  animation: iconPulse 3s ease-in-out infinite !important;
}

.dopamine-theme .feature-title {
  color: #2D1B4E !important;
  font-weight: 700 !important;
  font-size: 24rpx !important;
}

.dopamine-theme .feature-desc {
  color: #666 !important;
  font-weight: 500 !important;
}

.dopamine-theme .start-btn {
  background: linear-gradient(135deg, #FF6B9D 0%, #FFD93D 100%) !important;
  border: 4rpx solid #FFF !important;
  border-radius: 50rpx !important;
  box-shadow: 0 8rpx 25rpx rgba(255, 107, 157, 0.4), 
              0 4rpx 10rpx rgba(255, 215, 61, 0.3) inset !important;
  animation: pulse 2s ease-in-out infinite !important;
}

.dopamine-theme .start-btn::after {
  border: none !important;
}

.dopamine-theme .start-btn:active {
  transform: scale(0.95) !important;
}

.dopamine-theme .footer {
  background: linear-gradient(135deg, #FFF9E6 0%, #FFEFF5 100%) !important;
}

/* 多巴胺风动画 */
@keyframes gradientShift {
  0%, 100% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

@keyframes logoFloat {
  0%, 100% { transform: translateY(0) rotate(-3deg); }
  50% { transform: translateY(-15rpx) rotate(3deg); }
}

@keyframes textPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.8; }
}

@keyframes iconPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}
