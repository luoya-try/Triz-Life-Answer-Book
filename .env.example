# TRIZ 微信小程序环境变量配置
#
# 用法：
# 1. 复制本文件为 .env
# 2. 填入你的 API Key
# 3. 运行配置脚本
#
# Linux/macOS:
#   cp .env.example .env
#   # 编辑 .env 填入 API Key
#   TRIZ_APIKEY=$(cat .env | grep TRIZ_APIKEY | cut -d '=' -f2) node scripts/configure-api-key.js
#
# Windows (PowerShell):
#   cp .env.example .env
#   # 编辑 .env 填入 API Key
#   $env:TRIZ_APIKEY="nvapi-xxx"; node scripts/configure-api-key.js

# NVIDIA API Key
# 获取地址：https://build.nvidia.com/ -> API Keys
TRIZ_APIKEY=
